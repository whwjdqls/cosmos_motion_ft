+    def trainable_state_dict(self) -> dict[str, Any]:
+        """Full state filtered to ONLY trainable params (LoRA adapters + unfrozen heads).
+        Used for SAVING a LoRA run (apply on top of the base at eval); NOT for the
+        warm-start load template, which must stay full.
+
+        NOTE: filter by SUBSTRING on the state-dict keys (which are the canonical DCP keys),
+        NOT by matching named_parameters() FQNs — under FSDP the deep LoRA params get mangled
+        names that don't match get_model_state_dict keys, silently dropping all adapters.
+        """
+        sd = get_model_state_dict(self.model)
+        # LoRA adapters + any modules named in SAVE_TRAINABLE_KEYS (the keep-trainable heads).
+        keep = ["lora_A", "lora_B"] + [
+            m for m in os.environ.get(
+                "SAVE_TRAINABLE_KEYS", "action2llm,llm2action,action_modality_embed"
+            ).split(",") if m
+        ]
+        return {k: v for k, v in sd.items() if any(s in k for s in keep)}
