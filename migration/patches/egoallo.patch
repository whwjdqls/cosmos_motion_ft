@@ -0,0 +1,114 @@
+"""Nymeria-SOMA body-only adapter for the official EgoAllo trainer."""
+
+import json
+from functools import lru_cache
+from pathlib import Path
+
+import numpy as np
+import torch
+from scipy.spatial.transform import Rotation
+
+from .dataclass import EgoTrainingData
+
+
+def _matrices_from_6d(values):
+    x = values[..., :3].astype(np.float64)
+    y = values[..., 3:6].astype(np.float64)
+    x /= np.linalg.norm(x, axis=-1, keepdims=True)
+    z = np.cross(x, y)
+    z /= np.linalg.norm(z, axis=-1, keepdims=True)
+    y = np.cross(z, x)
+    return np.stack((x, y, z), axis=-1)
+
+
+def _wxyz(matrices):
+    xyzw = Rotation.from_matrix(matrices).as_quat()
+    return xyzw[..., [3, 0, 1, 2]].astype(np.float32)
+
+
+class NymeriaSomaDataset(torch.utils.data.Dataset):
+    def __init__(self, cache: Path, split: str = "train"):
+        self.cache = Path(cache)
+        self.metadata_root = self.cache / "egoallo_metadata_v1"
+        if not (self.metadata_root / "index.json").is_file():
+            raise FileNotFoundError("Run nymeria_baselines.prepare_egoallo_metadata for this cache first")
+        manifest = json.loads((self.cache / "index.json").read_text())
+        assert manifest["window"] == 97 and manifest["fps"] == 20
+        self.rows = [r for r in manifest["rows"] if r["split"] == split]
+        shape = np.load(self.cache / "body_shape16.npz")
+        self.body_joints = shape["body_joints"].astype(int)
+        self.parents = shape["parents"].astype(int)
+        self.shape_mean = shape["mean"].astype(np.float64)
+        self.shape_components = shape["components"].astype(np.float64)
+        self.shape_scale = shape["scale"].astype(np.float64)
+        assert len(self.body_joints) == 23
+
+    def __len__(self):
+        return len(self.rows)
+
+    @lru_cache(maxsize=8)
+    def _metadata(self, key):
+        return tuple(
+            np.load(self.metadata_root / f"{key}.{name}.npy", mmap_mode="r")
+            for name in ("world_root_zup", "joints_wrt_cpf")
+        )
+
+    @lru_cache(maxsize=8)
+    def _arrays(self, key):
+        root = self.cache / "records"
+        return tuple(np.load(root / f"{key}.{name}.npy", mmap_mode="r") for name in ("motion", "pose_zup", "neutral"))
+
+    def __getitem__(self, index):
+        row = self.rows[index]
+        motion_all, pose_all, neutral = self._arrays(row["array"])
+        start = row["start"]
+        motion = np.asarray(motion_all[start:start + 97], dtype=np.float64)
+        pose = np.array(pose_all[start:start + 97], dtype=np.float64, copy=True)
+        # The official denoiser reads camera Z directly as floor-relative
+        # height. Cache poses are z-up, with the same vertical sign as the
+        # recorded y-up ground offset. Never mutate the shared cache.
+        ground_offset = row["ground_offset_y"]
+        pose[:, 2, 3] -= 0.0 if ground_offset is None else float(ground_offset)
+        assert motion.shape == (97, 283) and pose.shape == (97, 4, 4)
+
+        # UniEgo stores per-joint orientation in a common canonical frame.
+        # Relative SOMA joint rotation is R_parent^T R_child; the shared
+        # canonical rotation therefore cancels without decoding world motion.
+        joint9 = motion[:, :270].reshape(97, 30, 9)
+        rotations = _matrices_from_6d(joint9[..., :6])[:, self.body_joints]
+        local = np.matmul(np.swapaxes(rotations[:, self.parents[1:]], -1, -2), rotations[:, 1:])
+        body_quats = _wxyz(local.reshape(-1, 3, 3)).reshape(97, 22, 4)
+
+        shape_vec = np.asarray(neutral, dtype=np.float64)[self.body_joints]
+        shape_vec = (shape_vec - shape_vec[0]).reshape(-1)
+        betas = ((self.shape_components @ (shape_vec - self.shape_mean)) / self.shape_scale).astype(np.float32)[None]
+
+        camera_quat = _wxyz(pose[:, :3, :3])
+        camera_xyz = pose[:, :3, 3].astype(np.float32)
+        world_camera = np.concatenate((camera_quat, camera_xyz), axis=-1)
+        relative = np.matmul(np.linalg.inv(pose[:-1]), pose[1:])
+        relative_quat = _wxyz(relative[:, :3, :3])
+        relative_xyz = relative[:, :3, 3].astype(np.float32)
+        relative_pose = np.concatenate((relative_quat, relative_xyz), axis=-1)
+        relative_pose = np.concatenate((np.array([[1, 0, 0, 0, 0, 0, 0]], dtype=np.float32), relative_pose), axis=0)
+
+        # These fields are not consumed by the body-only denoising loss, but
+        # they must still be correct for evaluation and future data consumers.
+        # Precomputation avoids decoding the entire recording for every crop.
+        root_all, cpf_joints_all = self._metadata(row["array"])
+        root = np.array(root_all[start:start + 97], dtype=np.float32, copy=True)
+        root[:, 6] -= 0.0 if ground_offset is None else float(ground_offset)
+        joints_wrt_cpf = np.array(cpf_joints_all[start:start + 97], dtype=np.float32, copy=True)
+
+        return EgoTrainingData(
+            T_world_root=torch.from_numpy(root.copy()),
+            contacts=torch.from_numpy(motion[:, -4:].astype(np.float32).copy()),
+            betas=torch.from_numpy(betas.copy()),
+            body_quats=torch.from_numpy(body_quats.copy()),
+            T_cpf_tm1_cpf_t=torch.from_numpy(relative_pose.copy()),
+            T_world_cpf=torch.from_numpy(world_camera.copy()),
+            height_from_floor=torch.from_numpy(camera_xyz[:, 2:3].copy()),
+            joints_wrt_cpf=torch.from_numpy(joints_wrt_cpf),
+            mask=torch.ones(97, dtype=torch.bool),
+            hand_quats=None,
+        )
